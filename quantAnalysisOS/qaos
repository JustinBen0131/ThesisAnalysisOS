#!/usr/bin/env python3
"""qaos: the quantAnalysisOS command line.

No install step. Needs Python 3.9 or newer and numpy. Run it from anywhere.
"""

from __future__ import annotations

import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
if HERE not in sys.path:
    sys.path.insert(0, HERE)

if sys.version_info < (3, 9):  # pragma: no cover
    sys.stderr.write("qaos needs Python 3.9 or newer; found {0}\n".format(sys.version.split()[0]))
    raise SystemExit(1)

try:
    import numpy  # noqa: F401
except ImportError:  # pragma: no cover
    sys.stderr.write("qaos needs numpy (pip install numpy). Nothing else.\n")
    raise SystemExit(1)

sys.dont_write_bytecode = True  # running qaos writes its record and nothing else

from qaos_core.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
