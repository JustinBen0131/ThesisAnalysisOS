{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/guard.py --agent codex",
            "timeout": 20,
            "statusMessage": "TAOS guard"
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/guard.py --agent codex",
            "timeout": 20,
            "statusMessage": "TAOS guard"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/session_start.py",
            "timeout": 20,
            "statusMessage": "TAOS status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/stop_labels.py --agent codex",
            "timeout": 20,
            "statusMessage": "TAOS label"
          }
        ]
      }
    ]
  }
}
