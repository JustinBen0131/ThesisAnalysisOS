{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taos.bootstrap.answers.v1",
  "title": "TAOS bootstrap answers",
  "type": "object",
  "required": ["principal_name", "project_name", "prefix", "first_tasks"],
  "properties": {
    "principal_name": {"type": "string", "minLength": 1, "maxLength": 80},
    "timezone": {"type": "string", "maxLength": 60},
    "project_name": {"type": "string", "minLength": 1, "maxLength": 80},
    "prefix": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,7}$"},
    "stack": {"enum": ["rust-cargo", "node", "python", "go", "generic"]},
    "gates": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["command"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "maxLength": 40},
          "command": {"type": "string", "minLength": 1, "maxLength": 300}
        }
      }
    },
    "git_isolation": {"enum": ["branch", "worktree", "fork", "trunk"]},
    "branch_pattern": {"type": "string", "minLength": 3, "maxLength": 120},
    "protected_branches": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 80}
    },
    "worktree_root": {"type": ["string", "null"], "maxLength": 300},
    "merge_policy": {"enum": ["human_pr", "agent_after_gates", "trunk"]},
    "autonomy": {"enum": ["propose_only", "edit_branches", "push_branches_open_prs"]},
    "max_decisions_per_day": {"type": "integer", "minimum": 0, "maximum": 50},
    "quiet_hours": {"type": ["string", "null"], "maxLength": 40},
    "self_iteration_cadence": {"enum": ["daily", "weekly", "manual"]},
    "planning_surface": {"enum": ["none", "files", "github-issues", "linear", "jira", "other"]},
    "brief_time": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
    "panel_port": {"type": "integer", "minimum": 1024, "maximum": 65535},
    "open_browser": {"type": "boolean"},
    "install_hooks_in_workspaces": {"type": "boolean"},
    "agents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["codex", "claude"]}
    },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "maxLength": 60},
          "path": {"type": "string", "pattern": "^[/~]", "minLength": 2},
          "primary": {"type": "boolean"},
          "agent": {"enum": ["codex", "claude", "any"]}
        }
      }
    },
    "human_only": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 3, "maxLength": 120}
    },
    "secret_patterns": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    },
    "first_tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["title"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string", "minLength": 3, "maxLength": 120},
          "goal": {"type": "string", "maxLength": 300},
          "next_action": {"type": "string", "maxLength": 300},
          "priority": {"enum": ["P0", "P1", "P2", "P3"]}
        }
      }
    },
    "agent_corrections": {
      "type": "array",
      "maxItems": 12,
      "items": {"type": "string", "minLength": 5, "maxLength": 240}
    }
  },
  "additionalProperties": false
}
